# Copie para .env (`make env` gera senhas aleatórias). Nunca suba o .env para o git.

# ── Postgres (banco único: schemas evolution, n8n, app) ──
POSTGRES_USER=bf
POSTGRES_PASSWORD=troque-me
POSTGRES_DB=bf

# ── Redis (cache da Evolution) ──
REDIS_URL=redis://redis:6379/6

# ── Evolution API (WhatsApp) ──
EVOLUTION_API_KEY=troque-me
EVOLUTION_INSTANCE=bftickets
EVOLUTION_PORT=8095

# ── n8n ──
N8N_ENCRYPTION_KEY=troque-me
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5679
# URL pública dos webhooks (na VPS: https://n8n.seudominio.com.br/)
WEBHOOK_URL=http://localhost:5679/
GENERIC_TIMEZONE=America/Bahia

# ── LLM (API da Anthropic; classifica/extrai no bot e escreve o texto da agenda a partir da arte no painel) ──
# Chave em https://platform.claude.com/settings/keys. claude-haiku-5-5 é o modelo mais barato.
LLM_BASE_URL=https://api.anthropic.com
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5

# ── Negócio ──
# Número do dono com DDI+DDD, só dígitos (recebe alertas e manda /comandos)
ADMIN_NUMERO=5571999999999
PAUSA_HUMANO_HORAS=12
DEBOUNCE_SEGUNDOS=6

# ── Instagram (ManyChat Pro) ──
# Token do header x-bf-token que o External Request do ManyChat envia
MANYCHAT_WEBHOOK_TOKEN=troque-me
# API key do ManyChat (Settings > API) para avisar o cliente do /aprovar no Instagram
MANYCHAT_API_KEY=

# ── NocoDB (planilha sobre o schema app) ──
NOCODB_PORT=8096
NOCODB_JWT_SECRET=troque-me
NOCODB_ADMIN_EMAIL=admin@bftickets.local
NOCODB_ADMIN_PASSWORD=troque-me

# ── Painel de gestão ──
PAINEL_PORT=5195
PAINEL_USUARIO=admin
PAINEL_SENHA=troque-me
# Segredo entre o painel e o n8n (webhook painel-admin)
PAINEL_TOKEN=troque-me
# Links que o painel mostra (na VPS, os domínios públicos)
LINK_N8N=http://localhost:5679
LINK_NOCODB=http://localhost:8096
